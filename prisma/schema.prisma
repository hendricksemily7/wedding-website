// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A Party represents an invitation - could be a single person, couple, or family
model Party {
  id            String   @id @default(cuid())
  name          String   // Display name for the party, e.g., "The Smith Family" or "John & Jane"
  slug          String   @unique
  guests        Guest[]  // Individual people in the party
  tasks         Task[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Individual guest within a party - each can RSVP separately
model Guest {
  id             String   @id @default(cuid())
  partyId        String
  party          Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  name           String   // Individual's name
  isWeddingParty Boolean  @default(false) // Wedding party members attend rehearsal dinner
  rsvp           RSVP?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RSVP {
  id                       String      @id @default(cuid())
  guestId                  String      @unique
  guest                    Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  attending                Boolean
  mealChoice               MealChoice?
  dietaryNotes             String?
  needsShuttle             Boolean     @default(false)
  attendingRehearsalDinner Boolean?    // Only applicable for wedding party members
  comments                 String?
  respondedAt              DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
}

model Vendor {
  id               String         @id @default(cuid())
  name             String
  category         VendorCategory
  contactName      String?
  email            String?
  phone            String?
  website          String?
  driveUrl         String?
  deliverables     String?
  notes            String?
  contractedAmount Decimal?       @db.Decimal(10, 2)
  paymentStatus    PaymentStatus  @default(PENDING)
  dueDate          DateTime?
  expenses         Expense[]
  tasks            Task[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Expense {
  id          String         @id @default(cuid())
  title       String
  category    ExpenseCategory
  amount      Decimal        @db.Decimal(10, 2)
  status      PaymentStatus  @default(PENDING)
  dueDate     DateTime?
  paidDate    DateTime?
  note        String?
  vendorId    String?
  vendor      Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, dueDate])
  @@index([vendorId])
}

model Task {
  id          String      @id @default(cuid())
  title       String
  details     String?
  status      TaskStatus  @default(TODO)
  dueDate     DateTime?
  owner       TaskOwner   @default(BOTH)
  vendorId    String?
  vendor      Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  partyId     String?
  party       Party?      @relation(fields: [partyId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, dueDate])
  @@index([vendorId])
  @@index([partyId])
}

enum MealChoice {
  CHICKEN
  SQUASH
  PASTA
}

enum VendorCategory {
  VENUE
  CATERING
  BAR
  PHOTOGRAPHY
  MUSIC
  FLORAL
  ATTIRE
  TRANSPORTATION
  STATIONERY
  RENTALS
  GIFTS
  BEAUTY
  OTHER
}

enum ExpenseCategory {
  VENUE
  FOOD_AND_BEVERAGE
  ATTIRE
  TRANSPORTATION
  FLORALS
  STATIONERY
  GIFTS
  BEAUTY
  RENTALS
  MUSIC
  PHOTOGRAPHY
  MISC
}

enum PaymentStatus {
  PENDING
  SCHEDULED
  PAID
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskOwner {
  JESS
  EM
  BOTH
}
